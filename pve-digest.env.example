# Copy to /etc/pve-digest/pve-digest.env and chmod 600.

# --- Proxmox VE -------------------------------------------------------------
# Host or URL of the PVE API. Port 8006 is assumed if omitted.
PVE_HOST=r730.lan
# API token: user@realm!tokenid, and its secret UUID.
PVE_TOKEN_ID=digest@pve!health
PVE_TOKEN_SECRET=00000000-0000-0000-0000-000000000000
# Node name as shown in the PVE UI. Optional if the cluster has only one node.
PVE_NODE=r730
# PVE uses a self-signed cert by default. Either point at its CA
# (/etc/pve/pve-root-ca.pem on the host) or set PVE_VERIFY_TLS=false.
PVE_CA_BUNDLE=
PVE_VERIFY_TLS=true

# --- ntfy -------------------------------------------------------------------
NTFY_URL=https://ntfy.your.url
NTFY_TOPIC=proxmox-digest
# Access token (tk_...) if the topic requires auth.
NTFY_TOKEN=
# Priority for a clean digest; digests with warnings are always sent as "high".
NTFY_PRIORITY=default

# --- Thresholds -------------------------------------------------------------
DISK_WARN_PCT=85
MEM_WARN_PCT=90
# RRD window for CPU avg/peak: hour, day, week, month, year.
RRD_TIMEFRAME=week
